# Faresight Environment Configuration - SIH PS26056
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit real API keys to version control.

# ============================================================
# SERPAPI CONFIGURATION (Multi-Key Round-Robin)
# ============================================================
# Comma-separated list of SerpApi keys provided by team members.
# Get your keys at https://serpapi.com/
# Example: SERP_API_KEYS=key1,key2,key3
SERP_API_KEYS=

# Active pointer for round-robin rotation (managed automatically)
# SERP_API_KEY_POINTER=0

# ============================================================
# TARGET FLIGHT ROUTES (Indian Corridors)
# ============================================================
# Fixed corridors for SIH26056 Airfare Price Index
ROUTES="DEL-BOM,BLR-DEL,MAA-DEL,CCU-BOM,HYD-DEL"

# Lead-time days in advance for fare sampling
LEAD_TIMES="1,3,5,7,15,30,45"

# ============================================================
# INDEX WEIGHTING CONFIGURATION
# ============================================================
# Short-Term Bucket (T+1, T+3): Weight = 0.40
# Medium-Term Bucket (T+5, T+7, T+15): Weight = 0.35
# Long-Term Bucket (T+30, T+45): Weight = 0.25
INDEX_SHORT_WEIGHT=0.40
INDEX_MEDIUM_WEIGHT=0.35
INDEX_LONG_WEIGHT=0.25

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# SQLite database path (default: ./airfare.db)
AIRFARE_DB_PATH=./airfare.db

# ============================================================
# AUTHENTICATION (Admin Panel)
# ============================================================
# HTTP Basic Auth credentials for /admin panel
# Change these to secure your admin operations
ADMIN_USERNAME=admin
ADMIN_PASSWORD=sih2026admin

# ============================================================
# SERPAPI FETCHER SETTINGS
# ============================================================
# Default timeout per SerpApi request (seconds)
# Falls back to SQLite cache if exceeded (protects UI performance during demos)
SERPAPI_TIMEOUT=4.0

# Maximum retries on transient failures
SERPAPI_MAX_RETRIES=2

# Fall back to SQLite cached data when SerpApi times out
SERPAPI_FALLBACK_TO_CACHE=true

# ==========================================================#
# FRONTEND / SERVER CONFIGURATION
# ============================================================
# FastAPI host and port
HOST=0.0.0.0
PORT=8000
DEBUG=false

# API prefix versioning
API_V1_PREFIX=/api/v1

# ============================================================
# OPTIONAL: FEATURE FLAGS
# ============================================================
# Enable/disable auto-throttling between SerpApi requests
AUTOTHROTTLE_ENABLED=false

# Maximum concurrent SerpApi requests per domain
CONCURRENT_REQUESTS_PER_DOMAIN=2